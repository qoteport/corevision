# Copy to deploy/gcp/config.env and edit. Used by setup.sh and deploy.sh.
PROJECT_ID=your-gcp-project-id
REGION=europe-west1                 # pick one close to your users; Cloud Run, Cloud SQL and the bucket all use it
SERVICE=corevision                  # Cloud Run service name
REPO=corevision                     # Artifact Registry repository
SQL_INSTANCE=corevision-db          # Cloud SQL instance name
SQL_TIER=db-g1-small                # shared-core; use db-custom-1-3840 or larger for production
BUCKET=your-gcp-project-id-corevision-photos   # must be globally unique
RUN_SA=corevision-run               # service account the app runs as

# The app has its own accounts and login (one organization per deployment), so it can be public.
# Optional extra layer: Google sign-in in front of it (Identity-Aware Proxy). Only useful if every
# user has a Google account in your Workspace; set IAP=1 and list them below.
IAP=0
# Comma-separated people or groups allowed through IAP, e.g. user:you@example.com,group:geology@example.com
IAP_MEMBERS=

# Scaling. Background AI analysis needs instance-based billing (no CPU throttling), set in deploy.sh.
MIN_INSTANCES=0
MAX_INSTANCES=4
